---
layout: null
permalink: /calendar.ics
---
BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Physics in the Age of AI//Seminar//EN
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:{{ site.title }}
X-WR-TIMEZONE:Europe/Paris
BEGIN:VTIMEZONE
TZID:Europe/Paris
BEGIN:DAYLIGHT
TZOFFSETFROM:+0100
TZOFFSETTO:+0200
TZNAME:CEST
DTSTART:19700329T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:+0200
TZOFFSETTO:+0100
TZNAME:CET
DTSTART:19701025T030000
RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU
END:STANDARD
END:VTIMEZONE
{% assign events = site.events | sort: "date" -%}
{% for e in events -%}
{% if e.notice %}{% continue %}{% endif -%}
{% assign e_end = e.end | default: e.date -%}
BEGIN:VEVENT
UID:{{ e.slug }}@physics-in-the-age-of-ai
DTSTAMP:{{ site.time | date: "%Y%m%dT%H%M%SZ" }}
DTSTART;TZID=Europe/Paris:{{ e.date | date: "%Y%m%dT%H%M%S" }}
DTEND;TZID=Europe/Paris:{{ e_end | date: "%Y%m%dT%H%M%S" }}
{% capture summary %}{% if e.calendar_title %}{{ e.calendar_title }}{% else %}{{ site.title }}: {{ e.title }}{% endif %}{% endcapture -%}
SUMMARY:{{ summary | replace: ",", "\," | replace: ";", "\;" }}
LOCATION:Room {{ e.room }}\, {{ site.venue.name | replace: ",", "\," }}\, {{ site.venue.address | replace: ",", "\," }}
DESCRIPTION:Speaker: {{ e.speaker | replace: ",", "\," | replace: ";", "\;" }}\n{{ e.url | absolute_url }}
URL:{{ e.url | absolute_url }}
END:VEVENT
{% endfor -%}
END:VCALENDAR
